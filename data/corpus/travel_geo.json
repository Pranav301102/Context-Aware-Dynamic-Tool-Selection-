              "route_onestop_ids": {"type": "array", "items": {"type": "string"}},
              "include_alerts": {"type": "boolean", "default": true},
              "include_geometry": {"type": "boolean", "default": false},
              "use_service_window": {"type": "boolean", "default": false},
              "limit": {"type": "integer", "default": 20}
            },
            "required": ["stop_key"]
          }
        },
