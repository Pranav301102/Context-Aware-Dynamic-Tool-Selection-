      "id": "transitland",
      "name": "Transitland",
      "server": "mcp://transitland",
      "summary": "Transitland open transit data: stops, routes, operators and scheduled/real-time departures for public transport agencies worldwide.",
      "tools": [
        {
          "name": "search_stops",
          "description": "Search public transit stops (bus stops, rail and metro stations, ferry terminals) by name or around a point. Returns Onestop IDs, names, coordinates and the routes serving each stop.",
          "input_schema": {
            "type": "object",
            "properties": {
              "search": {"type": "string", "description": "Full-text search on stop name."},
              "lat": {"type": "number"},
              "lon": {"type": "number"},
              "radius": {"type": "number", "default": 500, "description": "Meters around lat/lon."},
              "served_by_onestop_ids": {"type": "string", "description": "Comma-separated operator or route Onestop IDs."},
              "served_by_route_type": {"type": "integer", "description": "GTFS route_type (0 tram, 1 subway, 2 rail, 3 bus, 4 ferry)."},
              "limit": {"type": "integer", "default": 20, "maximum": 100}
            }
          }
        },
        {
          "name": "get_stop_departures",
