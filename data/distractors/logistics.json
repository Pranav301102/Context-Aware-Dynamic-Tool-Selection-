{
  "branch": {
    "id": "logistics",
    "name": "Logistics & Shipping",
    "summary": "Shipping and logistics: comparing carrier rates and buying shipping labels, tracking parcels, warehouse inventory and inbound receiving, international freight quotes and bookings, and fleet vehicle and driver tracking."
  },
  "toolkits": [
    {
      "id": "easypost",
      "name": "EasyPost",
      "server": "mcp://easypost",
      "summary": "Multi-carrier shipping API: address verification, rate shopping, labels, returns and pickups.",
      "tools": [
        {
          "name": "verify_address",
          "description": "Verify and standardize a shipping address and flag undeliverable ones.",
          "input_schema": {
            "type": "object",
            "properties": {
              "street1": {
                "type": "string",
                "description": "Street."
              },
              "street2": {
                "type": "string",
                "description": "Unit."
              },
              "city": {
                "type": "string",
                "description": "City."
              },
              "state": {
                "type": "string",
                "description": "State."
              },
              "zip": {
                "type": "string",
                "description": "ZIP."
              },
              "country": {
                "type": "string",
                "description": "Country.",
                "default": "US"
              }
            },
            "required": [
              "street1",
              "zip"
            ]
          }
        },
        {
          "name": "create_shipment",
          "description": "Create a shipment and get rates from all connected carriers (USPS, UPS, FedEx, DHL and others).",
          "input_schema": {
            "type": "object",
            "properties": {
              "to_address": {
                "type": "object",
                "description": "Destination.",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Contact name."
                  },
                  "company": {
                    "type": "string",
                    "description": "Company."
                  },
                  "street1": {
                    "type": "string",
                    "description": "Street line 1."
                  },
                  "street2": {
                    "type": "string",
                    "description": "Street line 2."
                  },
                  "city": {
                    "type": "string",
                    "description": "City."
                  },
                  "state": {
                    "type": "string",
                    "description": "State / province."
                  },
                  "zip": {
                    "type": "string",
                    "description": "Postal code."
                  },
                  "country": {
                    "type": "string",
                    "description": "ISO country code.",
                    "default": "US"
                  },
                  "phone": {
                    "type": "string",
                    "description": "Phone."
                  }
                },
                "required": [
                  "street1",
                  "city",
                  "zip",
                  "country"
                ]
              },
              "from_address": {
                "type": "object",
                "description": "Origin.",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Contact name."
                  },
                  "company": {
                    "type": "string",
                    "description": "Company."
                  },
                  "street1": {
                    "type": "string",
                    "description": "Street line 1."
                  },
                  "street2": {
                    "type": "string",
                    "description": "Street line 2."
                  },
                  "city": {
                    "type": "string",
                    "description": "City."
                  },
                  "state": {
                    "type": "string",
                    "description": "State / province."
                  },
                  "zip": {
                    "type": "string",
                    "description": "Postal code."
                  },
                  "country": {
                    "type": "string",
                    "description": "ISO country code.",
                    "default": "US"
                  },
                  "phone": {
                    "type": "string",
                    "description": "Phone."
                  }
                },
                "required": [
                  "street1",
                  "city",
                  "zip",
                  "country"
                ]
              },
              "parcel": {
                "type": "object",
                "description": "Package.",
                "properties": {
                  "length": {
                    "type": "number",
                    "description": "Inches."
                  },
                  "width": {
                    "type": "number",
                    "description": "Inches."
                  },
                  "height": {
                    "type": "number",
                    "description": "Inches."
                  },
                  "weight": {
                    "type": "number",
                    "description": "Ounces."
                  },
                  "predefined_package": {
                    "type": "string",
                    "description": "Carrier box name, e.g. 'FlatRateEnvelope'."
                  }
                },
                "required": [
                  "weight"
                ]
              },
              "customs_info": {
                "type": "object",
                "description": "Customs declaration for international shipments.",
                "properties": {
                  "contents_type": {
                    "type": "string",
                    "description": "Contents.",
                    "enum": [
                      "merchandise",
                      "gift",
                      "documents",
                      "returned_goods",
                      "sample"
                    ]
                  },
                  "customs_items": {
                    "type": "array",
                    "description": "Items.",
                    "items": {
                      "type": "object",
                      "description": "Item.",
                      "properties": {
                        "description": {
                          "type": "string",
                          "description": "Description."
                        },
                        "quantity": {
                          "type": "integer",
                          "description": "Qty."
                        },
                        "value": {
                          "type": "number",
                          "description": "USD value."
                        },
                        "weight": {
                          "type": "number",
                          "description": "Ounces."
                        },
                        "hs_tariff_number": {
                          "type": "string",
                          "description": "HS code."
                        },
                        "origin_country": {
                          "type": "string",
                          "description": "Country."
                        }
                      }
                    }
                  }
                }
              },
              "options": {
                "type": "object",
                "description": "Shipment options.",
                "properties": {
                  "label_format": {
                    "type": "string",
                    "description": "Label format.",
                    "enum": [
                      "PDF",
                      "PNG",
                      "ZPL"
                    ],
                    "default": "PDF"
                  },
                  "saturday_delivery": {
                    "type": "boolean",
                    "description": "Saturday delivery."
                  },
                  "signature_confirmation": {
                    "type": "string",
                    "description": "Signature.",
                    "enum": [
                      "NO_SIGNATURE",
                      "SIGNATURE",
                      "ADULT_SIGNATURE"
                    ]
                  }
                }
              },
              "reference": {
                "type": "string",
                "description": "Your order reference."
              }
            },
            "required": [
              "to_address",
              "from_address",
              "parcel"
            ]
          }
        },
        {
          "name": "get_rates",
          "description": "Get rates.",
          "input_schema": {
            "type": "object",
            "properties": {
              "shipment_id": {
                "type": "string",
                "description": "Shipment id."
              }
            },
            "required": [
              "shipment_id"
            ]
          }
        },
        {
          "name": "buy_label",
          "description": "Buy a postage label for a shipment using one of its rates.",
          "input_schema": {
            "type": "object",
            "properties": {
              "shipment_id": {
                "type": "string",
                "description": "Shipment id."
              },
              "rate_id": {
                "type": "string",
                "description": "Selected rate id."
              },
              "insurance_amount": {
                "type": "number",
                "description": "Declared value to insure (USD)."
              }
            },
            "required": [
              "shipment_id",
              "rate_id"
            ]
          }
        },
        {
          "name": "create_return_label",
          "description": "Create a return label for an existing shipment (swaps origin and destination).",
          "input_schema": {
            "type": "object",
            "properties": {
              "shipment_id": {
                "type": "string",
                "description": "Original shipment."
              },
              "carrier": {
                "type": "string",
                "description": "Carrier for the return."
              },
              "service": {
                "type": "string",
                "description": "Service level."
              }
            },
            "required": [
              "shipment_id"
            ]
          }
        },
        {
          "name": "refund_label",
          "description": "Request a refund for an unused label.",
          "input_schema": {
            "type": "object",
            "properties": {
              "shipment_id": {
                "type": "string",
                "description": "Shipment id."
              }
            },
            "required": [
              "shipment_id"
            ]
          }
        },
        {
          "name": "create_pickup",
          "description": "Schedule a carrier pickup for one or more shipments.",
          "input_schema": {
            "type": "object",
            "properties": {
              "shipment_ids": {
                "type": "array",
                "description": "Shipments to pick up.",
                "items": {
                  "type": "string"
                }
              },
              "address": {
                "type": "object",
                "description": "Pickup address.",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Contact name."
                  },
                  "company": {
                    "type": "string",
                    "description": "Company."
                  },
                  "street1": {
                    "type": "string",
                    "description": "Street line 1."
                  },
                  "street2": {
                    "type": "string",
                    "description": "Street line 2."
                  },
                  "city": {
                    "type": "string",
                    "description": "City."
                  },
                  "state": {
                    "type": "string",
                    "description": "State / province."
                  },
                  "zip": {
                    "type": "string",
                    "description": "Postal code."
                  },
                  "country": {
                    "type": "string",
                    "description": "ISO country code.",
                    "default": "US"
                  },
                  "phone": {
                    "type": "string",
                    "description": "Phone."
                  }
                },
                "required": [
                  "street1",
                  "city",
                  "zip",
                  "country"
                ]
              },
              "min_datetime": {
                "type": "string",
                "description": "Earliest pickup (ISO 8601)."
              },
              "max_datetime": {
                "type": "string",
                "description": "Latest pickup (ISO 8601)."
              },
              "instructions": {
                "type": "string",
                "description": "Driver instructions."
              }
            },
            "required": [
              "shipment_ids",
              "min_datetime",
              "max_datetime"
            ]
          }
        }
      ]
    },
    {
      "id": "aftership",
      "name": "AfterShip Tracking",
      "server": "mcp://aftership",
      "summary": "Track parcels across 1,100+ carriers with delivery estimates and customer notifications.",
      "tools": [
        {
          "name": "track_package",
          "description": "Get the latest tracking status and checkpoint history for a tracking number. The carrier is auto-detected if slug is omitted.",
          "input_schema": {
            "type": "object",
            "properties": {
              "tracking_number": {
                "type": "string",
                "description": "Tracking number."
              },
              "slug": {
                "type": "string",
                "description": "Carrier code, e.g. 'ups', 'fedex', 'usps', 'dhl'."
              }
            },
            "required": [
              "tracking_number"
            ]
          }
        },
        {
          "name": "create_tracking",
          "description": "Register a tracking number for monitoring and status-change notifications.",
          "input_schema": {
            "type": "object",
            "properties": {
              "tracking_number": {
                "type": "string",
                "description": "Tracking number."
              },
              "slug": {
                "type": "string",
                "description": "Carrier code."
              },
              "title": {
                "type": "string",
                "description": "Label for the shipment."
              },
              "order_id": {
                "type": "string",
                "description": "Order id."
              },
              "customer_emails": {
                "type": "array",
                "description": "Notify these emails.",
                "items": {
                  "type": "string"
                }
              },
              "customer_phone": {
                "type": "string",
                "description": "Notify by SMS."
              },
              "language": {
                "type": "string",
                "description": "Notification language.",
                "default": "en"
              }
            },
            "required": [
              "tracking_number"
            ]
          }
        },
        {
          "name": "list_trackings",
          "description": "List trackings",
          "input_schema": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string",
                "description": "Status tag.",
                "enum": [
                  "Pending",
                  "InfoReceived",
                  "InTransit",
                  "OutForDelivery",
                  "AttemptFail",
                  "Delivered",
                  "AvailableForPickup",
                  "Exception",
                  "Expired"
                ]
              },
              "keyword": {
                "type": "string",
                "description": "Search tracking number, title or order id."
              },
              "created_at_min": {
                "type": "string",
                "description": "ISO 8601."
              },
              "limit": {
                "type": "integer",
                "description": "Max results.",
                "default": 100
              }
            }
          }
        },
        {
          "name": "detect_carrier",
          "description": "Detect which carrier(s) a tracking number belongs to.",
          "input_schema": {
            "type": "object",
            "properties": {
              "tracking_number": {
                "type": "string",
                "description": "Tracking number."
              }
            },
            "required": [
              "tracking_number"
            ]
          }
        },
        {
          "name": "get_estimated_delivery",
          "description": "Predict the delivery date for a shipment from carrier, service level, origin and destination.",
          "input_schema": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "description": "Carrier code."
              },
              "service_type": {
                "type": "string",
                "description": "Service, e.g. 'FedEx Ground'."
              },
              "origin_postal_code": {
                "type": "string",
                "description": "Origin ZIP."
              },
              "origin_country": {
                "type": "string",
                "description": "Origin country."
              },
              "destination_postal_code": {
                "type": "string",
                "description": "Destination ZIP."
              },
              "destination_country": {
                "type": "string",
                "description": "Destination country."
              },
              "pickup_time": {
                "type": "string",
                "description": "Pickup time (ISO 8601)."
              }
            },
            "required": [
              "slug",
              "destination_postal_code",
              "destination_country"
            ]
          }
        }
      ]
    },
    {
      "id": "shipbob",
      "name": "ShipBob Fulfillment",
      "server": "mcp://shipbob",
      "summary": "Warehouse fulfillment: inventory by fulfillment center, inbound receiving orders, transfers and outbound order status.",
      "tools": [
        {
          "name": "list_fulfillment_centers",
          "description": "List warehouses (fulfillment centers) with address and timezone.",
          "input_schema": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "get_inventory_levels",
          "description": "Get on-hand, committed, fulfillable and backordered quantities per SKU, optionally per fulfillment center.",
          "input_schema": {
            "type": "object",
            "properties": {
              "skus": {
                "type": "array",
                "description": "SKUs; omit for all.",
                "items": {
                  "type": "string"
                }
              },
              "fulfillment_center_id": {
                "type": "integer",
                "description": "Warehouse id."
              },
              "include_lots": {
                "type": "boolean",
                "description": "Break down by lot / expiration date.",
                "default": false
              },
              "page_size": {
                "type": "integer",
                "description": "Page size.",
                "default": 100
              }
            }
          }
        },
        {
          "name": "create_receiving_order",
          "description": "Create a warehouse receiving order (WRO / advance shipping notice) for inbound inventory.",
          "input_schema": {
            "type": "object",
            "properties": {
              "fulfillment_center_id": {
                "type": "integer",
                "description": "Destination warehouse."
              },
              "package_type": {
                "type": "string",
                "description": "How inventory arrives.",
                "enum": [
                  "Package",
                  "Pallet",
                  "FloorLoadedContainer"
                ]
              },
              "box_packaging_type": {
                "type": "string",
                "description": "Box packing.",
                "enum": [
                  "EverythingInOneBox",
                  "OneSkuPerBox",
                  "MultipleSkuPerBox"
                ]
              },
              "boxes": {
                "type": "array",
                "description": "Boxes.",
                "items": {
                  "type": "object",
                  "description": "Box.",
                  "properties": {
                    "tracking_number": {
                      "type": "string",
                      "description": "Inbound tracking number."
                    },
                    "box_items": {
                      "type": "array",
                      "description": "Contents.",
                      "items": {
                        "type": "object",
                        "description": "Item.",
                        "properties": {
                          "sku": {
                            "type": "string",
                            "description": "SKU."
                          },
                          "quantity": {
                            "type": "integer",
                            "description": "Units."
                          },
                          "lot_number": {
                            "type": "string",
                            "description": "Lot."
                          },
                          "lot_date": {
                            "type": "string",
                            "description": "Expiration date."
                          }
                        },
                        "required": [
                          "sku",
                          "quantity"
                        ]
                      }
                    }
                  }
                }
              },
              "expected_arrival_date": {
                "type": "string",
                "description": "Expected arrival (YYYY-MM-DD)."
              },
              "purchase_order_number": {
                "type": "string",
                "description": "PO number."
              }
            },
            "required": [
              "fulfillment_center_id",
              "package_type",
              "boxes",
              "expected_arrival_date"
            ]
          }
        },
        {
          "name": "get_receiving_order",
          "description": "Get receiving order status.",
          "input_schema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "description": "Receiving order id."
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "name": "transfer_inventory",
          "description": "Move inventory between fulfillment centers.",
          "input_schema": {
            "type": "object",
            "properties": {
              "sku": {
                "type": "string",
                "description": "SKU."
              },
              "quantity": {
                "type": "integer",
                "description": "Units."
              },
              "from_fc_id": {
                "type": "integer",
                "description": "Source warehouse."
              },
              "to_fc_id": {
                "type": "integer",
                "description": "Destination warehouse."
              }
            },
            "required": [
              "sku",
              "quantity",
              "from_fc_id",
              "to_fc_id"
            ]
          }
        },
        {
          "name": "list_orders",
          "description": "List outbound orders and their fulfillment status.",
          "input_schema": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "description": "Status.",
                "enum": [
                  "Processing",
                  "Exception",
                  "PartiallyFulfilled",
                  "Fulfilled",
                  "Cancelled"
                ]
              },
              "start_date": {
                "type": "string",
                "description": "From (YYYY-MM-DD)."
              },
              "end_date": {
                "type": "string",
                "description": "To (YYYY-MM-DD)."
              },
              "reference_ids": {
                "type": "array",
                "description": "Store order ids.",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "freightos",
      "name": "Freightos",
      "server": "mcp://freightos",
      "summary": "Instant international freight quotes and bookings for ocean, air and trucking.",
      "tools": [
        {
          "name": "get_freight_quote",
          "description": "Get instant freight rate quotes for moving cargo between two locations.",
          "input_schema": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "object",
                "description": "Pickup location.",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "Location type.",
                    "enum": [
                      "port",
                      "airport",
                      "address",
                      "warehouse"
                    ]
                  },
                  "code_or_address": {
                    "type": "string",
                    "description": "UN/LOCODE, IATA code or full address."
                  }
                },
                "required": [
                  "type",
                  "code_or_address"
                ]
              },
              "destination": {
                "type": "object",
                "description": "Delivery location.",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "Location type.",
                    "enum": [
                      "port",
                      "airport",
                      "address",
                      "warehouse"
                    ]
                  },
                  "code_or_address": {
                    "type": "string",
                    "description": "UN/LOCODE, IATA code or full address."
                  }
                },
                "required": [
                  "type",
                  "code_or_address"
                ]
              },
              "mode": {
                "type": "string",
                "description": "Transport mode.",
                "enum": [
                  "ocean_fcl",
                  "ocean_lcl",
                  "air",
                  "express",
                  "truck_ltl",
                  "truck_ftl"
                ]
              },
              "load": {
                "type": "object",
                "description": "Cargo.",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "Load type.",
                    "enum": [
                      "boxes",
                      "pallets",
                      "container_20",
                      "container_40",
                      "container_40hc"
                    ]
                  },
                  "quantity": {
                    "type": "integer",
                    "description": "Count."
                  },
                  "weight_kg": {
                    "type": "number",
                    "description": "Total weight."
                  },
                  "volume_cbm": {
                    "type": "number",
                    "description": "Total volume."
                  }
                },
                "required": [
                  "type",
                  "quantity"
                ]
              },
              "ready_date": {
                "type": "string",
                "description": "Cargo ready date (YYYY-MM-DD)."
              },
              "commodity": {
                "type": "string",
                "description": "Commodity description."
              },
              "hazardous": {
                "type": "boolean",
                "description": "Dangerous goods.",
                "default": false
              },
              "incoterm": {
                "type": "string",
                "description": "Incoterm.",
                "enum": [
                  "EXW",
                  "FOB",
                  "CIF",
                  "DAP",
                  "DDP"
                ]
              }
            },
            "required": [
              "origin",
              "destination",
              "load"
            ]
          }
        },
        {
          "name": "book_freight",
          "description": "Book quote.",
          "input_schema": {
            "type": "object",
            "properties": {
              "quote_id": {
                "type": "string",
                "description": "Quote id."
              },
              "shipper": {
                "type": "object",
                "description": "Shipper contact and address.",
                "additionalProperties": true
              },
              "consignee": {
                "type": "object",
                "description": "Consignee contact and address.",
                "additionalProperties": true
              },
              "cargo_description": {
                "type": "string",
                "description": "Description."
              },
              "pickup_date": {
                "type": "string",
                "description": "Pickup (YYYY-MM-DD)."
              }
            },
            "required": [
              "quote_id"
            ]
          }
        },
        {
          "name": "list_bookings",
          "description": "List freight bookings by status.",
          "input_schema": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "description": "Status.",
                "enum": [
                  "booked",
                  "in_transit",
                  "at_port",
                  "customs",
                  "delivered",
                  "cancelled"
                ]
              }
            }
          }
        },
        {
          "name": "get_booking_milestones",
          "description": "Get milestone tracking (pickup, departure, arrival, customs clearance, delivery) for a freight booking.",
          "input_schema": {
            "type": "object",
            "properties": {
              "booking_id": {
                "type": "string",
