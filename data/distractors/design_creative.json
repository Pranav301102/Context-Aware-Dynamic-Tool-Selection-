{
  "branch": {
    "id": "design_creative",
    "name": "Design & Creative",
    "summary": "Design and creative work: Figma files, components and design comments, Canva designs and exports, stock photo search, and brand asset libraries with logos, color palettes and brand guidelines."
  },
  "toolkits": [
    {
      "id": "figma",
      "name": "Figma",
      "server": "mcp://figma",
      "summary": "Read Figma design files, nodes, components, variables and comments, and export rendered images.",
      "tools": [
        {
          "name": "get_file",
          "description": "Retrieve a Figma file as a JSON document tree, including pages, frames and layers. Use depth to limit how deep the node tree is traversed for large files.",
          "input_schema": {
            "type": "object",
            "properties": {
              "file_key": {
                "type": "string",
                "description": "Figma file key (from the file URL figma.com/file/<key>/...)."
              },
              "depth": {
                "type": "integer",
                "description": "How deep into the document tree to traverse; 1 returns only pages."
              },
              "version": {
                "type": "string",
                "description": "A specific version ID to fetch. Defaults to the current version."
              },
              "branch_data": {
                "type": "boolean",
                "description": "Include branch metadata.",
                "default": false
              },
              "geometry": {
                "type": "string",
                "enum": [
                  "paths"
                ],
                "description": "Set to 'paths' to export vector data."
              }
            },
            "required": [
              "file_key"
            ]
          }
        },
        {
          "name": "get_file_nodes",
          "description": "Get specific nodes (frames, components, layers) from a file by node ID.",
          "input_schema": {
            "type": "object",
            "properties": {
              "file_key": {
                "type": "string",
                "description": "Figma file key (from the file URL figma.com/file/<key>/...)."
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Node IDs, e.g. 1:23."
              },
              "depth": {
                "type": "integer"
              }
            },
            "required": [
              "file_key",
              "ids"
            ]
          }
        },
        {
          "name": "export_images",
          "description": "Render nodes from a file as PNG, JPG, SVG or PDF and return temporary image URLs (expire after 30 days).",
          "input_schema": {
            "type": "object",
            "properties": {
              "file_key": {
                "type": "string",
                "description": "Figma file key (from the file URL figma.com/file/<key>/...)."
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Node IDs to render."
              },
              "format": {
                "type": "string",
                "enum": [
                  "png",
                  "jpg",
                  "svg",
                  "pdf"
                ],
                "default": "png"
              },
              "scale": {
                "type": "number",
                "description": "Image scale factor between 0.01 and 4.",
                "default": 1
              },
              "svg_include_id": {
                "type": "boolean",
                "description": "Include id attributes on SVG elements.",
                "default": false
              },
              "use_absolute_bounds": {
                "type": "boolean",
                "description": "Use full node dimensions, ignoring cropping."
              }
            },
            "required": [
              "file_key",
              "ids"
            ]
          }
        },
        {
          "name": "list_comments",
          "description": "List comments on a file.",
          "input_schema": {
            "type": "object",
            "properties": {
              "file_key": {
                "type": "string",
                "description": "Figma file key (from the file URL figma.com/file/<key>/...)."
              },
              "as_md": {
                "type": "boolean",
                "description": "Return message bodies as markdown."
              }
            },
            "required": [
              "file_key"
            ]
          }
        },
        {
          "name": "post_comment",
          "description": "Post a comment on a file, optionally pinned to a node or canvas position, or as a reply to an existing comment thread.",
          "input_schema": {
            "type": "object",
            "properties": {
              "file_key": {
                "type": "string",
                "description": "Figma file key (from the file URL figma.com/file/<key>/...)."
              },
              "message": {
                "type": "string"
              },
              "comment_id": {
                "type": "string",
                "description": "Reply to this comment instead of starting a thread."
              },
              "client_meta": {
                "type": "object",
                "properties": {
                  "node_id": {
                    "type": "string"
                  },
                  "node_offset": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  }
                },
                "description": "Where to pin the comment."
              }
            },
            "required": [
              "file_key",
              "message"
            ]
          }
        },
        {
          "name": "list_team_projects",
          "description": "List projects in a team.",
          "input_schema": {
            "type": "object",
            "properties": {
              "team_id": {
                "type": "string"
              }
            },
            "required": [
              "team_id"
            ]
          }
        },
        {
          "name": "list_project_files",
          "description": "List files in a project with name, thumbnail and last modified time.",
          "input_schema": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "string"
              },
              "branch_data": {
                "type": "boolean",
                "description": "Include branches.",
                "default": false
              }
            },
            "required": [
              "project_id"
            ]
          }
        },
        {
          "name": "get_file_versions",
          "description": "Version history of a file.",
          "input_schema": {
            "type": "object",
            "properties": {
              "file_key": {
                "type": "string",
                "description": "Figma file key (from the file URL figma.com/file/<key>/...)."
              },
              "page_size": {
                "type": "integer",
                "description": "Versions per page.",
                "default": 30
              }
            },
            "required": [
              "file_key"
            ]
          }
        },
        {
          "name": "list_team_components",
          "description": "List published components in a team library, with thumbnail, name, description and containing frame.",
          "input_schema": {
            "type": "object",
            "properties": {
              "team_id": {
                "type": "string"
              },
              "page_size": {
                "type": "integer",
                "description": "Max 1000.",
                "default": 30
              },
              "after": {
                "type": "string",
                "description": "Cursor for next page."
              }
            },
            "required": [
              "team_id"
            ]
          }
        },
        {
          "name": "get_component",
          "description": "Get metadata for a published component by key.",
          "input_schema": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              }
            },
            "required": [
              "key"
            ]
          }
        },
        {
          "name": "get_local_variables",
          "description": "Get design tokens (variables and variable collections such as colors, spacing and typography modes) defined in a file. Enterprise plans only.",
          "input_schema": {
            "type": "object",
            "properties": {
              "file_key": {
                "type": "string",
                "description": "Figma file key (from the file URL figma.com/file/<key>/...)."
              }
            },
            "required": [
              "file_key"
            ]
          }
        }
      ]
    },
    {
      "id": "unsplash",
      "name": "Unsplash",
      "server": "mcp://unsplash",
      "summary": "Search and retrieve free high-resolution stock photography from Unsplash.",
      "tools": [
        {
          "name": "search_photos",
          "description": "Search Unsplash for free high-resolution stock photos by keyword, color and orientation.",
          "input_schema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "page": {
                "type": "integer",
                "description": "Page number.",
                "default": 1
              },
              "per_page": {
                "type": "integer",
                "description": "Results per page (max 30).",
                "default": 10
              },
              "order_by": {
                "type": "string",
                "enum": [
                  "relevant",
                  "latest"
                ],
                "default": "relevant"
              },
              "color": {
                "type": "string",
                "enum": [
                  "black_and_white",
                  "black",
                  "white",
                  "yellow",
                  "orange",
                  "red",
                  "purple",
                  "magenta",
                  "green",
                  "teal",
                  "blue"
                ]
              },
              "orientation": {
                "type": "string",
                "enum": [
                  "landscape",
                  "portrait",
                  "squarish"
                ]
              },
              "content_filter": {
                "type": "string",
                "enum": [
                  "low",
                  "high"
                ],
                "description": "Content safety level.",
                "default": "low"
              }
            },
            "required": [
              "query"
            ]
          }
        },
        {
          "name": "get_photo",
          "description": "Get a photo's details: photographer, EXIF, location, tags and download links.",
          "input_schema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "name": "get_random_photo",
          "description": "Return one or more random photos, optionally matching a query or collection.",
          "input_schema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "collections": {
                "type": "string",
                "description": "Comma-separated collection IDs."
              },
              "orientation": {
                "type": "string",
                "enum": [
                  "landscape",
                  "portrait",
                  "squarish"
                ]
              },
              "count": {
                "type": "integer",
                "description": "Number of photos, 1-30.",
                "default": 1
              }
            }
          }
        },
        {
          "name": "track_download",
          "description": "Trigger a download event for a photo (required by API guidelines when a photo is used).",
          "input_schema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "name": "list_collection_photos",
          "description": "List photos in a collection.",
          "input_schema": {
            "type": "object",
            "properties": {
              "collection_id": {
                "type": "string"
              },
              "page": {
                "type": "integer"
              },
              "per_page": {
                "type": "integer"
              }
            },
            "required": [
              "collection_id"
            ]
          }
        }
      ]
    },
    {
      "id": "frontify",
      "name": "Frontify",
      "server": "mcp://frontify",
      "summary": "Brand management platform: brand guidelines, color palettes and a digital asset library of logos, images and templates.",
      "tools": [
        {
          "name": "search_assets",
          "description": "Search the brand library for logos, images, icons, templates and documents by keyword, type or tag.",
          "input_schema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "asset_type": {
                "type": "string",
                "enum": [
                  "image",
                  "logo",
                  "icon",
                  "video",
                  "document",
                  "template",
                  "font"
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "library_id": {
                "type": "string",
                "description": "Restrict to one library."
              },
              "limit": {
                "type": "integer",
                "description": "Max results.",
                "default": 25
              }
            },
            "required": [
              "query"
            ]
          }
        },
        {
          "name": "get_asset",
          "description": "Get asset metadata and download URL.",
          "input_schema": {
            "type": "object",
            "properties": {
              "asset_id": {
                "type": "string"
              },
              "rendition": {
                "type": "string",
                "enum": [
                  "original",
                  "web",
                  "thumbnail"
                ],
                "default": "original"
              }
            },
            "required": [
              "asset_id"
            ]
          }
        },
        {
          "name": "upload_asset",
          "description": "Upload a new asset to a library folder from a URL, with title, description, tags and optional expiry date.",
          "input_schema": {
            "type": "object",
            "properties": {
              "library_id": {
                "type": "string"
              },
              "folder_id": {
                "type": "string"
              },
              "file_url": {
                "type": "string",
                "description": "Publicly reachable URL of the file to import."
              },
              "filename": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expires_at": {
                "type": "string",
                "description": "ISO date after which the asset is marked expired (e.g. license end)."
              }
            },
            "required": [
              "library_id",
              "file_url"
            ]
          }
        },
        {
          "name": "get_brand_guidelines",
          "description": "Fetch a brand guideline page (logo usage, clear space, typography, tone of voice) as structured text.",
          "input_schema": {
            "type": "object",
            "properties": {
              "guideline_id": {
                "type": "string"
              },
              "section": {
                "type": "string",
                "description": "Optional section title to return, e.g. 'Logo misuse'."
              }
            },
            "required": [
              "guideline_id"
            ]
          }
        },
        {
          "name": "get_color_palette",
          "description": "Return the brand color palettes with HEX, RGB, CMYK and Pantone values.",
          "input_schema": {
            "type": "object",
            "properties": {
              "brand_id": {
                "type": "string"
              },
              "palette_name": {
                "type": "string",
                "description": "Name of a specific palette, e.g. Primary."
              }
            },
            "required": [
              "brand_id"
            ]
          }
        },
        {
          "name": "create_share_link",
          "description": "Create a time-limited public share link for one or more assets.",
          "input_schema": {
            "type": "object",
            "properties": {
              "asset_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expires_in_days": {
                "type": "integer",
                "description": "Link lifetime.",
                "default": 7
              },
              "allow_download": {
                "type": "boolean",
                "description": "Allow recipients to download originals.",
                "default": true
              },
              "password": {
                "type": "string",
                "description": "Optional password protection."
              }
            },
            "required": [
              "asset_ids"
            ]
          }
        }
      ]
    },
    {
      "id": "canva",
      "name": "Canva",
      "server": "mcp://canva-connect",
      "summary": "Create, autofill and export Canva designs and manage uploaded media via the Canva Connect API.",
      "tools": [
        {
          "name": "create_design",
          "description": "Create a new blank Canva design of a preset type or custom size.",
          "input_schema": {
            "type": "object",
            "properties": {
              "design_type": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "preset",
                      "custom"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "enum": [
                      "doc",
                      "whiteboard",
                      "presentation"
                    ],
                    "description": "Preset name when type=preset."
                  },
                  "width": {
                    "type": "integer",
                    "description": "Width in pixels when type=custom."
                  },
                  "height": {
                    "type": "integer",
                    "description": "Height in pixels when type=custom."
                  }
                },
                "required": [
                  "type"
                ]
              },
              "title": {
                "type": "string"
              },
              "asset_id": {
                "type": "string",
                "description": "Optional image asset to insert."
              }
            },
            "required": [
              "design_type"
            ]
          }
        },
        {
          "name": "list_designs",
          "description": "List or search designs the user owns or has access to.",
          "input_schema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "ownership": {
                "type": "string",
                "enum": [
                  "any",
                  "owned",
                  "shared"
                ],
                "default": "any"
              },
              "sort_by": {
                "type": "string",
                "enum": [
                  "relevance",
                  "modified_descending",
                  "modified_ascending",
                  "title_ascending",
                  "title_descending"
                ]
              },
              "limit": {
                "type": "integer"
              }
            }
          }
        },
        {
          "name": "export_design",
          "description": "Start an export job for a design to PDF, PNG, JPG, GIF, PPTX or MP4. Returns a job ID; poll get_export_job for download URLs.",
          "input_schema": {
            "type": "object",
            "properties": {
              "design_id": {
                "type": "string"
              },
              "format": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "pdf",
                      "png",
                      "jpg",
                      "gif",
                      "pptx",
                      "mp4"
                    ]
                  },
                  "pages": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "1-based page numbers. Omit for all."
                  },
                  "quality": {
                    "type": "integer",
                    "description": "JPG quality 1-100."
                  },
                  "export_quality": {
                    "type": "string",
                    "enum": [
                      "regular",
                      "pro"
                    ],
                    "default": "regular"
                  },
                  "size": {
                    "type": "string",
                    "enum": [
                      "a4",
                      "a3",
                      "letter",
                      "legal"
                    ],
                    "description": "PDF paper size."
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "design_id",
              "format"
            ]
          }
        },
        {
          "name": "get_export_job",
          "description": "Check export job status.",
          "input_schema": {
            "type": "object",
            "properties": {
              "job_id": {
                "type": "string"
              }
            },
            "required": [
              "job_id"
            ]
          }
        },
        {
          "name": "autofill_brand_template",
          "description": "Generate a new design by filling a brand template's data fields with text, images or chart data.",
          "input_schema": {
            "type": "object",
            "properties": {
              "brand_template_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "data": {
                "type": "object",
                "description": "Map of field name to value.",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "text",
                        "image",
                        "chart"
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "asset_id": {
                      "type": "string"
                    },
                    "chart_data": {
                      "type": "object",
                      "description": "Rows for chart fields.",
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              }
            },
            "required": [
              "brand_template_id",
              "data"
            ]
          }
        },
        {
          "name": "upload_asset",
          "description": "Upload an image or video into the user's Canva media library from a URL.",
          "input_schema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "name"
            ]
          }
        }
      ]
    }
  ]
}
