                  },
                  "email": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "address": {
                    "type": "object",
                    "properties": {
                      "line1": {
                        "type": "string",
                        "description": "Street address."
                      },
                      "line2": {
                        "type": "string",
                        "description": "Apartment, suite or unit."
                      },
                      "city": {
                        "type": "string"
                      },
                      "state": {
                        "type": "string",
                        "description": "State or region code."
                      },
                      "postal_code": {
                        "type": "string"
                      },
                      "country": {
                        "type": "string",
                        "description": "ISO 3166-1 alpha-2 country code.",
                        "default": "US"
                      }
                    },
                    "description": "Postal address.",
                    "required": [
                      "line1",
                      "city",
                      "postal_code"
                    ]
                  }
                },
                "required": [
                  "first_name",
                  "last_name"
                ]
              },
              "line_of_business": {
                "type": "string",
                "enum": [
                  "personal_auto",
                  "homeowners",
                  "renters",
                  "commercial_property",
                  "general_liability",
                  "workers_comp",
                  "commercial_auto"
